#!/usr/bin/env bash
# Polban CLI — sudo polban
set -euo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SRC="${PB_SRC:-/opt/polban-src}"
# Find the real install dir (old installs copied this file to /usr/local/bin)
APP="${PB_APP:-}"
for d in "$APP" "$(cd "$(dirname "$SELF")/.." && pwd)" /home/polban; do
  if [[ -n "$d" && -f "$d/config.php" ]]; then APP="$d"; break; fi
done
[[ -n "$APP" ]] || APP="/home/polban"
VERSION="?"
for d in "$APP" "$SRC"; do
  if [[ -f "$d/VERSION" ]]; then VERSION="$(tr -d '[:space:]' < "$d/VERSION")"; break; fi
done
SRC_VERSION="$(tr -d '[:space:]' < "$SRC/VERSION" 2>/dev/null || echo '?')"

need_root() {
  if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
    echo "با root اجرا کنید:  sudo polban"
    exit 1
  fi
}

status() {
  echo "پل‌بان $VERSION (سورس: $SRC_VERSION)"
  echo "نصب:     $APP"
  echo "سورس:    $SRC"
  if [[ -f "$APP/config.php" ]]; then
    php -r '$c=require "'"$APP"'/config.php"; echo "base_url: ".($c["base_url"]?:"(خالی)")."\n"; echo "allowlist: ".count((array)$c["allowlist"])."\n"; echo "admin:    /".trim($c["admin_path"],"/")."\n";'
  else
    echo "config.php نیست — نصب را کامل کنید."
  fi
  if command -v curl >/dev/null 2>&1 && [[ -f "$APP/config.php" ]]; then
    base="$(php -r 'echo rtrim((require "'"$APP"'/config.php")["base_url"]??"", "/");')"
    if [[ -n "$base" ]]; then
      echo -n "health:   "
      curl -fsS --max-time 8 "$base/v1/health" || echo "unreachable"
      echo
    fi
  fi
}

menu() {
  need_root
  while true; do
    echo
    echo "======= پل‌بان $VERSION ======="
    echo "  1) نصب / باز‌پیکربندی"
    echo "  2) به‌روزرسانی از سورس git"
    echo "  3) وضعیت"
    echo "  4) نمایش مسیر پنل مدیریت وب"
    echo "  5) خروج"
    echo "================================"
    read -r -p "گزینه: " c </dev/tty || exit 0
    case "$c" in
      1)
        if [[ -f "$APP/config.php" ]]; then
          read -r -p "نصب قبلی وجود دارد؛ نصب تازه کلید API و رمز پنل را عوض می‌کند. ادامه؟ (yes/no) " y </dev/tty || y=""
          [[ "$y" == "yes" ]] || { echo "لغو شد."; continue; }
        fi
        bash "$SRC/install.sh" --install --dir "$APP" || echo "نصب ناموفق بود."
        ;;
      2)
        if [[ ! -f "$APP/config.php" ]]; then
          echo "هنوز نصب نشده؛ گزینهٔ ۱ را بزنید."
        elif [[ -d "$SRC/.git" ]]; then
          git -C "$SRC" pull --ff-only && bash "$SRC/install.sh" --update --dir "$APP" || echo "به‌روزرسانی ناموفق بود."
        else
          echo "سورس git در $SRC پیدا نشد. اول کلون کنید."
        fi
        ;;
      3) status ;;
      4)
        if [[ -f "$APP/config.php" ]]; then
          php -r '$c=require "'"$APP"'/config.php"; echo rtrim($c["base_url"],"/")."/".trim($c["admin_path"],"/")."/\n";'
        else
          echo "هنوز نصب نشده."
        fi
        ;;
      5) exit 0 ;;
      *) echo "گزینه نامعتبر" ;;
    esac
  done
}

cmd="${1:-}"
case "$cmd" in
  ""|menu) menu ;;
  status) status ;;
  update)
    need_root
    [[ -d "$SRC/.git" ]] || { echo "no git src at $SRC"; exit 1; }
    git -C "$SRC" pull --ff-only
    exec bash "$SRC/install.sh" --update --dir "$APP"
    ;;
  install)
    need_root
    exec bash "${SRC}/install.sh" --install --dir "$APP"
    ;;
  help|-h|--help)
    echo "sudo polban          منوی مدیریت"
    echo "sudo polban status   وضعیت"
    echo "sudo polban update   git pull + نصب"
    echo "sudo polban install  اجرای install.sh"
    ;;
  *) echo "unknown: $cmd"; exit 1 ;;
esac
